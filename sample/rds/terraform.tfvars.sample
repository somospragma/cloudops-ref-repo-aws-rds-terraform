##############################################################
# PC-IAC-026: terraform.tfvars — configuración declarativa SIN IDs hardcodeados
# Los IDs dinámicos (VPC, SG, subnets, KMS) son inyectados en locals.tf desde data sources
##############################################################

# ---- Gobernanza ----
profile              = "my-aws-profile"   # Reemplazar con tu profile de ~/.aws/credentials
aws_region_principal = "us-east-1"
aws_region_secondary = "us-east-2"        # Solo si multi-región; si no, usar la misma región

environment = "dev"
client      = "pragma"
project     = "idp"
service     = "db"

common_tags = {
  environment = "dev"
  project     = "idp"
  client      = "pragma"
  owner       = "cloudops"
  cost-center = "123"
  area        = "infrastructure"
  provisioned = "terraform"
}

##############################################################
# rds_config — map(object) para estabilidad en for_each
# Dos ejemplos documentados: serverless v2 y instancia provisionada
# Solo dejar activo el que necesites
##############################################################

rds_config = {

  # ---- Ejemplo A: Aurora Serverless v2 (db.serverless) ----
  "backstage" = {
    create_global_cluster = false
    engine                = "aurora-postgresql"
    engine_version        = "16.6"
    database_name         = "backstage"
    deletion_protection   = true
    storage_encrypted     = true
    serverless_deploy     = true   # ← activa serverlessv2_scaling_configuration

    cluster_config = [
      {
        principal                   = true
        region                      = "us-east-1"
        engine_mode                 = "provisioned"  # siempre provisioned para serverless v2
        manage_master_user_password = true
        master_username             = "master"
        # vpc_security_group_ids e subnet_ids se inyectan en locals.tf
        vpc_security_group_ids      = []
        subnet_ids                  = []
        backup_retention_period     = 7
        skip_final_snapshot         = true
        preferred_backup_window     = "03:00-04:00"
        # kms_key_id inyectado en locals.tf
        kms_key_id                  = ""
        port                        = "5432"
        service                     = "db"
        enabled_cloudwatch_logs_exports = ["postgresql"]
        copy_tags_to_snapshot       = true
        enable_http_endpoint        = false

        cluster_parameter = {
          family      = "aurora-postgresql16"
          description = "Cluster parameter group aurora-postgresql16"
          parameters  = []
        }

        # Requerido cuando serverless_deploy = true
        cluster_scaling_configuration = {
          max_capacity             = 2
          min_capacity             = 0.5
          seconds_until_auto_pause = 3600
        }

        instance_parameter = {
          family     = "aurora-postgresql16"
          parameters = []
        }

        cluster_instances = [
          {
            record_id                             = "instance-1"
            instance_class                        = "db.serverless"  # obligatorio para serverless v2
            publicly_accessible                   = false
            auto_minor_version_upgrade            = true
            performance_insights_enabled          = true   # soportado en db.serverless
            performance_insights_retention_period = 7
            # kms para PI inyectado en locals.tf — dejar vacío aquí
            performance_insights_kms_key_id       = ""
            monitoring_interval                   = 0
            monitoring_role_arn                   = ""
          }
        ]
      }
    ]
  }

  # ---- Ejemplo B: Instancia provisionada (db.t3.medium) ----
  # Descomentar para usar este modo
  # "backstage-prov" = {
  #   create_global_cluster = false
  #   engine                = "aurora-postgresql"
  #   engine_version        = "16.6"
  #   database_name         = "backstage"
  #   deletion_protection   = true
  #   storage_encrypted     = true
  #   serverless_deploy     = false   # ← instancia provisionada
  #
  #   cluster_config = [
  #     {
  #       principal                   = true
  #       region                      = "us-east-1"
  #       engine_mode                 = "provisioned"
  #       manage_master_user_password = true
  #       master_username             = "master"
  #       vpc_security_group_ids      = []
  #       subnet_ids                  = []
  #       backup_retention_period     = 7
  #       skip_final_snapshot         = true
  #       preferred_backup_window     = "03:00-04:00"
  #       kms_key_id                  = ""
  #       port                        = "5432"
  #       service                     = "db"
  #       enabled_cloudwatch_logs_exports = ["postgresql"]
  #       copy_tags_to_snapshot       = true
  #       enable_http_endpoint        = false
  #       cluster_parameter = {
  #         family      = "aurora-postgresql16"
  #         description = "Cluster parameter group aurora-postgresql16"
  #         parameters  = []
  #       }
  #       cluster_scaling_configuration = null  # ignorado cuando serverless_deploy=false
  #       instance_parameter = {
  #         family     = "aurora-postgresql16"
  #         parameters = []
  #       }
  #       cluster_instances = [
  #         {
  #           record_id                             = "instance-1"
  #           instance_class                        = "db.t3.medium"
  #           publicly_accessible                   = false
  #           auto_minor_version_upgrade            = true
  #           performance_insights_enabled          = false   # db.t3.medium NO soporta PI
  #           performance_insights_retention_period = 7
  #           performance_insights_kms_key_id       = ""
  #           monitoring_interval                   = 0
  #           monitoring_role_arn                   = ""
  #         }
  #       ]
  #     }
  #   ]
  # }
}
