###########################################
########## Common variables ###############
###########################################

profile     = "profile01"
aws_region  = "us-east-1"
environment = "dev"
client      = "pragma"
project     = "idp"
common_tags = {
  environment   = "dev"
  project-name  = "proyecto01"
  cost-center   = "123"
  owner         = "Acme"
  area          = "TI"
  provisioned   = "terraform"
  datatype      = "db"
}

###########################################
############## RDS variables ##############
###########################################

aws_region_principal                      = "us-east-1"
aws_region_secondary                      = "us-west-2"

create_global_cluster                     = false                             # Create a global cluster
serverless_deploy                         = true
cluster_application                       = "serverless-sample"                          
engine                                    = "aurora-postgresql"                    
engine_version                            = "16.6"         
database_name                             = "sample"                          
deletion_protection                       = true                             # Enable deletion protection

principal                                 = true                              
region                                    = "us-east-1"                       # Lowest cost region
engine_mode                               = "provisioned"                     
manage_master_user_password               = true                             # true only when create_global_cluster is false       
#master_password                          = ""                                # Master user password only if manage_master_user_password is false
master_username                           = "master"                           
backup_retention_period                   = 7                                 # Backup retention for 7 days
skip_final_snapshot                       = true                              # Don't take final snapshot
preferred_backup_window                   = "00:00-00:30"                     # Backup window
storage_encrypted                         = true                              # No storage encryption
kms_key_id_principal                      = "arn:aws:kms:us-east-1:008971642453:key/2a9dd3ab-d630-487a-b8ce-65c13dbf180f"
kms_key_id_secondary                      = "arn:aws:kms:us-west-2:008971642453:key/11842d1a-81ff-4ee2-9598-94ac02d0615f"
port                                      = "3306"                            
service                                   = "default"                         
enabled_cloudwatch_logs_exports           = ["postgresql","iam-db-auth-error"]                                
copy_tags_to_snapshot                     = true                              # Copy tags to snapshots
enable_http_endpoint                      = true
family                                    = "aurora-postgresql16"                       

# Type of instance, for example db.t3.medium. 
# When using serverless use the value db.serverless. 
# When using Aurora global use a Memory-optimized instance class type for example db.r5.large
# An Aurora global database requires DB instance classes that are optimized for memory-intensive applications.
# We recommend that you use a db.r5 or higher instance class.
# https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/aurora-global-database.configuration.requirements.html          
instance_class                            = "db.serverless" 

publicly_accessible                       = false                             # Don't publicly expose the instance
auto_minor_version_upgrade                = true                              # Automatic updates
performance_insights_enabled              = true                              # Disable Performance Insights
performance_insights_retention_period     = 7                                 # Keep 7 days of performance data
performance_insights_kms_key_id           = "arn:aws:kms:us-east-1:008971642453:key/2a9dd3ab-d630-487a-b8ce-65c13dbf180f"
monitoring_interval                       = 30   
monitoring_role_arn                       = "arn:aws:iam::008971642453:role/rds-monitoring-role"

scaling_max_capacity                      = 1
scaling_min_capacity                      = 0
scaling_seconds_until_auto_pause          = 86400